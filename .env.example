########################################################################
# Airflow + Spark plug-and-play stack — environment configuration
# `make init` copies this to .env (gitignored, read automatically by
# docker compose) and generates the Fernet key / JWT secret for you.
########################################################################

# ---- Versions (bump here, nowhere else) ------------------------------
AIRFLOW_VERSION=3.3.1
AIRFLOW_IMAGE_NAME=airflow-spark:${AIRFLOW_VERSION}
SPARK_VERSION=4.1.3
SPARK_SCALA_VERSION=2.13
SPARK_IMAGE_NAME=apache/spark:${SPARK_VERSION}-scala${SPARK_SCALA_VERSION}-java17-python3-ubuntu
# Built from spark.Dockerfile on top of SPARK_IMAGE_NAME above — adds
# pandas/pyarrow/numpy, needed by executors for applyInPandas / pandas UDF
# jobs. See CLAUDE.md "Decisiones no obvias", punto 10.
SPARK_CUSTOM_IMAGE_NAME=airflow-spark-spark:${SPARK_VERSION}
# Must match the Python shipped by SPARK_IMAGE_NAME (see CLAUDE.md, punto 3).
PYTHON_VERSION=3.10

# ---- Airflow core ------------------------------------------------------
# AIRFLOW_UID is intentionally not set here: `make init` appends your host
# UID (`id -u`) to .env, so the bind-mounted dags/ logs/ plugins/ config/
# stay owned by you instead of being chowned to the image default (50000).
AIRFLOW_PROJ_DIR=.
# Dev-only defaults, plug-and-play — see CLAUDE.md "Seguridad (solo para dev local)".
# `make init` replaces these two placeholders with generated values. By hand:
#   openssl rand -base64 32 | tr '+/' '-_'   # Fernet key
#   openssl rand -hex 32                     # JWT secret
AIRFLOW_FERNET_KEY=please_generate_your_own_fernet_key
AIRFLOW_JWT_SECRET=please_change_me_super_secret_jwt
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ---- Celery worker (1 worker x 1 CPU x 4GB RAM) ------------------------
AIRFLOW_WORKER_CPU_LIMIT=1
AIRFLOW_WORKER_MEM_LIMIT=4g
# 1 real core per worker -> 2-4 concurrent tasks is realistic
AIRFLOW_WORKER_CONCURRENCY=4

# ---- Spark standalone cluster -----------------------------------------
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8081
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=4g
SPARK_WORKER_WEBUI_PORT=8082
# Driver/Application UI (Spark UI por job, expuesta desde airflow-worker-1
# porque ahi corre el driver en deploy_mode=client)
SPARK_DRIVER_UI_PORT=4040

# ---- Postgres / Redis ---------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ---- Your project's own variables --------------------------------------
# Anything added here reaches every Airflow container (env_file: .env in
# docker-compose.yaml), i.e. DAGs and the Spark driver. It does NOT reach
# spark-master/spark-worker — pass values to executors explicitly.

########################################################################
# Resource limits — calibrated for an 8-core / 32GB host.
# Hard limits (1 Airflow worker + 2 Spark workers) total 3 cores / 12GB.
# These add caps on the "control plane" services so nothing hogs CPU and
# the peak stays around ~6.2 cores / ~17GB, leaving headroom for the OS.
# Lower these further (or comment deploy.resources blocks) on smaller hosts.
########################################################################
AIRFLOW_APISERVER_CPU_LIMIT=0.5
AIRFLOW_APISERVER_MEM_LIMIT=1g
AIRFLOW_SCHEDULER_CPU_LIMIT=0.5
AIRFLOW_SCHEDULER_MEM_LIMIT=1g
AIRFLOW_DAGPROCESSOR_CPU_LIMIT=0.3
AIRFLOW_DAGPROCESSOR_MEM_LIMIT=512m
AIRFLOW_TRIGGERER_CPU_LIMIT=0.2
AIRFLOW_TRIGGERER_MEM_LIMIT=512m
SPARK_MASTER_CPU_LIMIT=1
SPARK_MASTER_MEM_LIMIT=1g
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEM_LIMIT=1g
REDIS_CPU_LIMIT=0.2
REDIS_MEM_LIMIT=256m
